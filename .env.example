# Variables del SERVIDOR (proceso Node). Ver docs/DESPLIEGUE.md
PORT=8080
HOST=0.0.0.0
# Orígenes permitidos para el WebSocket, separados por comas (vacío = cualquiera). Ej.: https://juego.midominio.com
ALLOWED_ORIGINS=
# Carpeta del cliente compilado (por defecto ./dist si existe; "none" para no servir estáticos)
STATIC_DIR=
# Bajas para ganar (por defecto 20)
KILL_LIMIT=20

# Variables del BUILD del cliente (se fijan al compilar, prefijo VITE_)
# URL del servidor de juego si NO es el mismo origen que sirve la página. Ej.: wss://juego.midominio.com
VITE_SERVER_URL=
# Subruta de despliegue (por defecto "/"). Ej.: /barcelona-fps/
VITE_BASE=/
